# Application Settings
APP_NAME=TaskPlanner
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=task_planner
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# JWT Settings
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./apple_private_key.p8
APPLE_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# AWS S3 (for image storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=task-planner-images
AWS_REGION=us-east-1

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Email Settings (for notifications)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@taskplanner.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=TaskPlanner

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/gif", "image/webp"]
