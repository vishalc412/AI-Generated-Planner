# Application Settings
APP_NAME=TaskPlanner
DEBUG=True

# Database - Using MongoDB from docker-compose
MONGODB_URL=mongodb://admin:admin123@mongodb:27017
MONGODB_DB_NAME=task_planner

# JWT - CHANGE THIS IN PRODUCTION!
SECRET_KEY=dev-secret-key-please-change-in-production

# OAuth - Leave empty if not using
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# AWS S3 - Leave empty for development (image upload will be disabled)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Redis - Using Redis from docker-compose
REDIS_URL=redis://redis:6379/0

# Email - Optional
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS - Frontend URL
CORS_ORIGINS=["http://localhost:3000"]
